---
layout: base.njk
section: ai-gen
pagination:
  data: albums
  size: 1
  alias: album
  addAllPagesToCollections: true
permalink: "/vault/ps-gems/{{ album.slug }}/"
eleventyComputed:
  title: "{{ album.title }}"
  albumSlug: "{{ album.slug }}"
---
<div class="album">
  <h1>{{ album.title }}</h1>
  <p class="kicker">{{ album.count }}
    <span data-l="en">images</span><span data-l="vi">ảnh</span>
  </p>

  {%- for g in album.groups %}
  {%- if g.name %}<h2 class="group-h">{{ g.name }}</h2>{% endif %}
  <div class="shots">
    {%- for src in g.images %}
    {% photo src, album.title %}
    {%- endfor %}
  </div>
  {%- endfor %}
</div>
