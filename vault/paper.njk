---
layout: base.njk
section: papers
pagination:
  data: papers
  size: 1
  alias: paper
  # Không có dòng này thì collections.all chỉ chứa trang đầu tiên,
  # nên sitemap sẽ bỏ sót 13/14 trang tài liệu.
  addAllPagesToCollections: true
permalink: "/vault/papers/{{ paper.slug }}/"
eleventyComputed:
  title: "{{ paper.title }}"
  paperSlug: "{{ paper.slug }}"
---
{%- set meta = abstracts[paper.slug] -%}
<article class="prose paper">
  <h1>{{ paper.title }}</h1>

  <p class="kicker">
    {%- if paper.code %}<span class="pcode">{{ paper.code }}</span> &middot; {% endif -%}
    {{ paper.pages }} <span data-l="en">pages</span><span data-l="vi">trang</span>
  </p>

  <p class="lede">
    <span data-l="en">Asks</span><span data-l="vi">Câu hỏi</span>: {{ paper.asks }}.
  </p>

  <p class="paper-actions">
    <a class="btn" href="/corpus/{{ paper.pdf }}">
      <span data-l="en">Read PDF</span><span data-l="vi">Đọc bản PDF</span>
    </a>
    <a class="btn" href="https://doi.org/{{ paper.doi }}">
      <span data-l="en">DOI record</span><span data-l="vi">Bản ghi DOI</span>
    </a>
  </p>

  {%- if meta.abstract %}
  <h2><span data-l="en">Abstract</span><span data-l="vi">Tóm tắt</span></h2>
  <p class="abstract" data-l="en" lang="en">{{ meta.abstract }}</p>
  {%- if meta.abstract_vi %}
  <div data-l="vi" lang="vi">
    <p class="abstract">{{ meta.abstract_vi }}</p>
    {#  Nói rõ đây là bản dịch: nguyên văn đã công bố là tiếng Anh,
        nên không ai được trích bản này như thể là nguyên bản.  #}
    <p class="tr-note">Bản dịch. Nguyên văn tiếng Anh nằm trong bản PDF
      và trên bản ghi DOI.</p>
  </div>
  {%- endif %}
  {%- endif %}

  {%- if meta.keywords %}
  <p class="keywords">
    <span class="k-label"><span data-l="en">Keywords</span><span data-l="vi">Từ khoá</span></span>
    <span data-l="en" lang="en">{{ meta.keywords }}</span>
    <span data-l="vi" lang="vi">{{ meta.keywords_vi or meta.keywords }}</span>
  </p>
  {%- endif %}

  <p class="doi-line">
    <a href="https://doi.org/{{ paper.doi }}">{{ paper.doi }}</a>
  </p>
</article>
