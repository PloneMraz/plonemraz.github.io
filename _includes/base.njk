{#  Khoang trang giua hai the la CO Y: trinh duyet chi hien mot ban
    nen khong anh huong gi, nhung may doc van ban thuan se thay
    "Home Trang chu" thay vi "HomeTrang chu" dinh lien.  #}
{%- macro t(s) -%}<span data-l="en">{{ s.en }}</span> <span data-l="vi">{{ s.vi }}</span>{%- endmacro -%}
{%- from "gems-tree.njk" import docTree -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-ui-lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Plone Mraz</title>
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
<link rel="icon" href="/visual/plonemraz-32.png">
<link rel="apple-touch-icon" href="/visual/plonemraz-180.png">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">

{#  Thẻ chia sẻ. Không có mấy dòng này thì Facebook và các nơi khác
    chỉ hiện một URL trần khi ai đó chia sẻ link.  #}
{%- set isArticle = "/vault/blog/" in page.url
      or ("/vault/gems-space/" in page.url and page.url != "/vault/gems-space/") %}
{%- set ogType = "article" if isArticle else "website" %}
<meta property="og:type" content="{{ ogType }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ summary or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/visual/plonemraz.jpg">
<meta property="og:locale" content="{{ "vi_VN" if lang == "vi" else "en_US" }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ summary or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/visual/plonemraz.jpg">
<script>
/* Đặt trạng thái TRƯỚC khi vẽ, nếu không sẽ thấy chớp: trang hiện
   tiếng Anh rồi mới đổi sang Việt, hoặc thanh dọc bung ra rồi mới
   thu vào. Phải nằm trong <head>, trước cả stylesheet. */
(function () {
  var r = document.documentElement;
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  var l = get('ui-lang');
  if (l !== 'en' && l !== 'vi') {
    l = (navigator.language || '').toLowerCase().indexOf('vi') === 0 ? 'vi' : 'en';
  }
  r.setAttribute('data-ui-lang', l);
  r.lang = l;   // để trình đọc màn hình và trình duyệt biết đúng ngôn ngữ đang hiện
})();
</script>
{#  Umami — đo lượt xem và sự kiện. Không dùng cookie nên không
    cần banner đồng ý.  #}
<script defer src="https://cloud.umami.is/script.js"
        data-website-id="9f201127-5390-459b-800c-6595e8aba080"></script>
<link rel="stylesheet" href="/theme.css">
<link rel="stylesheet" href="/assets/vault.css">
</head>
<body class="{% if hideSidebar %}no-sidebar{% endif %}">

{% include "orb.njk" %}

{%- set tabs = [
  { url: "/",                   key: "home",       en: ui.nav.home.en,   vi: ui.nav.home.vi,  solo: true },
  { url: "/vault/",             key: "blog",       en: "Blog",           vi: "Blog" },
  { url: "/vault/papers/",      key: "papers",     en: ui.nav.papers.en, vi: ui.nav.papers.vi },
  { url: "/vault/ps-gems/",     key: "ai-gen",     en: "P's Gems",       vi: "P's Gems" },
  { url: "/vault/fiction/",     key: "fiction",    en: "Fiction",        vi: "Fiction" },
  { url: "/vault/vibe-coding/", key: "code",       en: "Vibe Coding",    vi: "Vibe Coding" },
  { url: "/vault/gems/",        key: "gems",       en: "GEMs",           vi: "GEMs" },
  { url: "/vault/gems-space/",  key: "gems-space", en: "Gem's Space",    vi: "Gem's Space" },
  { url: "/vault/books/",       key: "books",      en: ui.nav.books.en,  vi: ui.nav.books.vi },
  { url: "/vault/about/",       key: "about",      en: ui.nav.about.en,  vi: ui.nav.about.vi, solo: true }
] -%}

<header class="topbar">
  <a class="brand" href="/">
    <img src="/visual/plonemraz-64.webp" alt="" width="28" height="28">
    <span>Plone Mraz</span>
  </a>

  {#  Nút đổi ngôn ngữ đứng NGAY SAU thương hiệu, không phải sau menu:
      nó thuộc về khối bên trái, và chính chỗ đứng này làm khoảng trống
      của thanh rơi vào giữa nó với menu, đẩy menu sang phải.  #}
  <button class="langtoggle" type="button" aria-label="Switch interface language">
    <span data-l="en">EN</span> <span data-l="vi">VIE</span>
  </button>

  {#  Thanh ngang cho màn rộng. Màn hẹp thì nó ẩn đi và mười mục này
      chuyển vào bảng điều hướng bên dưới.  #}
  <nav class="topnav">
    {%- for tb in tabs %}
    <a href="{{ tb.url }}" class="{% if section == tb.key %}on{% endif %}"><span data-l="en">{{ tb.en }}</span> <span data-l="vi">{{ tb.vi }}</span></a>
    {%- endfor %}
  </nav>

  {#  MỘT nút duy nhất cho màn hẹp, góc trên bên phải. Nó mở bảng
      chứa cả mười mục lẫn danh sách của mục đang đứng — trước đây
      là hai nút mở hai thanh riêng.  #}
  <button class="nav-toggle" id="nav-toggle" type="button"
          aria-expanded="false" aria-controls="navpanel" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</header>

{#  Cột dọc — chỉ có trên màn rộng, và luôn hiện. Không còn nút
    đóng/mở: màn rộng thì thừa chỗ, màn hẹp thì nó đã nằm trong
    bảng điều hướng rồi.  #}
{% if not hideSidebar %}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-scroll">
{% set navSection = section %}{% include "section-list.njk" %}
  </div>
</aside>
{% endif %}

{#  Bảng điều hướng của màn hẹp. Mười mục; mục đang đứng xổ sẵn
    danh sách bên trong nó.  #}
<div class="navpanel" id="navpanel">
  <ul class="np-tabs">
    {%- for tb in tabs %}
    {%- set isOn = (section == tb.key) %}
    <li class="{% if isOn %}on{% endif %}">
      {%- if tb.solo %}
      <a class="np-link" href="{{ tb.url }}"><span data-l="en">{{ tb.en }}</span> <span data-l="vi">{{ tb.vi }}</span></a>
      {%- else %}
      <div class="np-row">
        <a class="np-link" href="{{ tb.url }}"><span data-l="en">{{ tb.en }}</span> <span data-l="vi">{{ tb.vi }}</span></a>
        {#  Bấm tên tab thì CHUYỂN TRANG; bấm mũi tên thì chỉ xổ danh
            sách ngay tại chỗ, không rời trang đang đọc.  #}
        <button class="np-expand" type="button" aria-controls="np-{{ tb.key }}"
                aria-expanded="{% if isOn %}true{% else %}false{% endif %}"
                aria-label="{{ tb.en }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>
      <div class="np-list" id="np-{{ tb.key }}"{% if not isOn %} hidden{% endif %}>
        {%- set navSection = tb.key %}{% include "section-list.njk" %}
      </div>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</div>
<div class="np-scrim" id="np-scrim"></div>

{#  Ô tìm kiếm đứng riêng, KHÔNG nằm trong cột dọc nữa: màn rộng thì
    nó ghim đáy cột dọc như cũ, màn hẹp thì nó ghim đỉnh bảng điều
    hướng. Một phần tử, hai chỗ đứng — tránh trùng id.  #}
<div class="search" id="search">
  <div class="search-panel" id="search-panel" hidden></div>
  <div class="search-box">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </svg>
    <input type="search" id="search-input" autocomplete="off" spellcheck="false"
           placeholder="Search" data-ph-en="Search" data-ph-vi="Tìm kiếm"
           aria-label="Search">
  </div>
</div>

<main class="content">
  {{ content | safe }}
</main>

{%- if section == 'ai-gen' %}
<div class="lbox" id="lbox" role="dialog" aria-modal="true" aria-label="Image viewer">
  <img id="lbox-img" alt="">
  <button class="lbox-close" id="lbox-close" aria-label="Close">&times;</button>
  <button class="lbox-prev"  id="lbox-prev"  aria-label="Previous">&#8249;</button>
  <button class="lbox-next"  id="lbox-next"  aria-label="Next">&#8250;</button>
  <span class="lbox-count" id="lbox-count"></span>
</div>
{%- endif %}

<script>
(function () {
  var root = document.documentElement;
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  /* ---------- Ngôn ngữ giao diện ---------- */
  var input = document.getElementById('search-input');
  function applyLang(l) {
    root.setAttribute('data-ui-lang', l);
    root.lang = l;
    if (input) input.placeholder = input.getAttribute('data-ph-' + l) || 'Search';
  }
  applyLang(root.getAttribute('data-ui-lang') || 'en');

  document.querySelector('.langtoggle').addEventListener('click', function () {
    var next = root.getAttribute('data-ui-lang') === 'en' ? 'vi' : 'en';
    applyLang(next);
    save('ui-lang', next);
  });

  /* ---------- Một bảng điều hướng duy nhất ----------
     Trước đây có hai nút mở hai thanh: nút hamburger mở thanh ngang,
     nút tròn mở thanh dọc. Trên màn rộng thì hợp lý, trên điện thoại
     thì thành hai thứ làm gần như cùng một việc.

     Nay: màn rộng KHÔNG có nút nào — thanh ngang và cột dọc đều luôn
     hiện. Màn hẹp có đúng một nút ở góc trên bên phải, mở một bảng
     chứa cả mười mục lẫn danh sách của mục đang đứng. */
  var navToggle = document.getElementById('nav-toggle');
  var navPanel  = document.getElementById('navpanel');
  var navScrim  = document.getElementById('np-scrim');

  function setNav(open) {
    root.setAttribute('data-nav', open ? 'open' : 'closed');
    if (navToggle) navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  function navOpen() { return root.getAttribute('data-nav') === 'open'; }

  /* KHÔNG lưu trạng thái này. Bảng là một lớp đè tạm, mở ra để chọn
     rồi đóng — nhớ nó qua các lần tải chỉ làm người đọc mở trang lên
     là thấy bảng chắn mất bài. */
  setNav(false);

  if (navToggle) {
    navToggle.addEventListener('click', function (e) {
      e.stopPropagation();
      setNav(!navOpen());
    });
  }

  if (navScrim) navScrim.addEventListener('click', function () { setNav(false); });

  /* Nút mũi tên: xổ danh sách của một tab ngay trong bảng, không rời
     trang. Bấm vào TÊN tab thì vẫn chuyển trang như thường. */
  if (navPanel) {
    navPanel.addEventListener('click', function (e) {
      var btn = e.target.closest('.np-expand');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      var list = document.getElementById(btn.getAttribute('aria-controls'));
      if (!list) return;
      var open = list.hasAttribute('hidden');
      if (open) list.removeAttribute('hidden'); else list.setAttribute('hidden', '');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  // Chọn một mục thì đóng bảng, nhường chỗ đọc
  if (navPanel) {
    navPanel.addEventListener('click', function (e) {
      if (e.target.closest('a')) setNav(false);
    });
  }

  /* Bấm ra ngoài bảng thì đóng — NHƯNG ô tìm kiếm không tính là
     "ngoài". Nó nằm ngoài #navpanel trong cây DOM (vì màn rộng nó
     phải ghim vào cột dọc), mà trên màn hẹp nó lại là một phần của
     cùng một bảng. Không trừ nó ra thì chạm vào ô để gõ là bảng
     đóng, ô trượt đi mất, người dùng gõ mà không thấy mình gõ gì. */
  document.addEventListener('click', function (e) {
    if (navOpen() &&
        !e.target.closest('#navpanel') &&
        !e.target.closest('#nav-toggle') &&
        !e.target.closest('#search')) {
      setNav(false);
    }
  });

  // Chọn một kết quả tìm kiếm thì đóng bảng, giống như chọn trong danh sách
  var searchBox = document.getElementById('search');
  if (searchBox) {
    searchBox.addEventListener('click', function (e) {
      if (e.target.closest('a')) setNav(false);
    });
  }

  // Esc đóng bảng
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && navOpen()) setNav(false);
  });

  /* ---------- Nút phản hồi ----------
     Hai khối .vote trên mỗi bài (đầu và cuối) dùng chung một khoá,
     nên bấm ở đâu thì cả hai cùng đổi. Lựa chọn lưu trong máy người
     đọc để họ quay lại vẫn thấy mình đã bỏ phiếu, và để không bỏ
     phiếu hai lần.

     GHI CHÚ QUAN TRỌNG: sendVote() hiện KHÔNG gửi đi đâu cả. Site
     là tĩnh, không có máy chủ, nên muốn đếm được thì phải cắm một
     dịch vụ vào đúng hàm này. Chừng nào chưa cắm, lượt bấm chỉ nằm
     trong trình duyệt người đọc. */
  var VOTE_GAP = 800;        // bỏ qua bấm dồn dập dưới ngưỡng này
  var lastVoteAt = 0;

  function sendVote(key, value) {
    /* Ba lớp chặn mềm. Không lớp nào chống được người cố tình — site
       tĩnh không có máy chủ để kiểm — nhưng chúng loại được bấm nhầm,
       bấm dồn, và đổi ý qua lại. Cách phát hiện phá thật sự là so số
       phiếu với số khách duy nhất trong Umami. */
    var now = Date.now();
    if (now - lastVoteAt < VOTE_GAP) return;   // (1) chặn bấm dồn
    lastVoteAt = now;

    var sentKey = 'voted:' + key;              // (2) mỗi phiên chỉ gửi một lần
    try {
      if (sessionStorage.getItem(sentKey)) return;
      sessionStorage.setItem(sentKey, '1');
    } catch (e) {}

    if (window.umami && typeof window.umami.track === 'function') {
      window.umami.track('vote', { post: key, value: value });   // (3) kèm URL bài
    }
  }

  var voteBlocks = [].slice.call(document.querySelectorAll('.vote'));
  if (voteBlocks.length) {
    var voteKey = voteBlocks[0].getAttribute('data-vote-key');
    var storeKey = 'vote:' + voteKey;
    var current = null;
    try { current = localStorage.getItem(storeKey); } catch (e) {}

    function paint() {
      voteBlocks.forEach(function (block) {
        [].slice.call(block.querySelectorAll('.vote-btn')).forEach(function (b) {
          b.setAttribute('aria-pressed',
            b.getAttribute('data-vote') === current ? 'true' : 'false');
        });
      });
    }
    paint();

    voteBlocks.forEach(function (block) {
      block.addEventListener('click', function (e) {
        var btn = e.target.closest('.vote-btn');
        if (!btn) return;
        var picked = btn.getAttribute('data-vote');
        current = (current === picked) ? null : picked;
        try {
          if (current) localStorage.setItem(storeKey, current);
          else localStorage.removeItem(storeKey);
        } catch (err) {}
        paint();
        if (current) sendVote(voteKey, current);
      });
    });
  }

  /* ---------- Tìm kiếm ----------
     Khớp theo tên bài và tag. Gõ #tag để lọc riêng theo tag; tag
     lồng nhau nên #triet-hoc bắt luôn #triet-hoc/ban-the.
     Bỏ dấu trước khi so, nên "cay den" tìm ra "Cây Đèn". */
  var panel = document.getElementById('search-panel');
  if (!input || !panel) return;

  function fold(s) {
    return (s || '').normalize('NFD')
      .split('').filter(function (c) {
        var k = c.charCodeAt(0); return k < 0x300 || k > 0x36f;
      }).join('')
      .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();
  }

  /* Chèn bằng innerHTML nên phải thoát ký tự: tiêu đề có dấu ngoặc
     kép, và về sau tag do người viết đặt cũng có thể chứa ký tự lạ. */
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  /* Cắt tại ranh giới từ để không đứt giữa chữ */
  function clip(s, n) {
    s = String(s == null ? '' : s).trim();
    if (s.length <= n) return s;
    return s.slice(0, n).replace(/\s+\S*$/, '') + '…';
  }

  var data = null, loading = false;
  function load() {
    if (data || loading) return;
    loading = true;
    fetch('/search.json')
      .then(function (r) { return r.json(); })
      .then(function (j) { data = j; loading = false; run(); })
      .catch(function () { loading = false; });
  }

  function match(q) {
    if (!data) return [];
    if (q.charAt(0) === '#') {
      var tag = fold(q.slice(1));
      if (!tag) return [];
      return data.filter(function (it) {
        return (it.tags || []).some(function (t) {
          var f = fold(t);
          return f === tag || f.indexOf(tag + '/') === 0 || f.indexOf(tag) === 0;
        });
      });
    }
    var n = fold(q);
    return data.filter(function (it) {
      return fold(it.title).indexOf(n) > -1 ||
             fold(it.summary).indexOf(n) > -1 ||
             (it.tags || []).some(function (t) { return fold(t).indexOf(n) > -1; });
    });
  }

  function run() {
    var q = input.value.trim();
    if (!q) { panel.hidden = true; panel.innerHTML = ''; return; }
    if (!data) { load(); return; }

    var hits = match(q).slice(0, 12);
    if (!hits.length) {
      panel.innerHTML = '<p class="search-empty">' +
        '<span data-l="en">No match</span> <span data-l="vi">Không có kết quả</span></p>';
    } else {
      panel.innerHTML = hits.map(function (it) {
        var tags = (it.tags || []).map(function (t) {
          return '<span class="t">#' + esc(t) + '</span>';
        }).join('');
        var sum = clip(it.summary, 110);
        return '<a href="' + esc(it.url) + '">' +
          '<span class="r-title">' + esc(it.title) + '</span>' +
          (sum ? '<span class="r-sum">' + esc(sum) + '</span>' : '') +
          '<span class="r-meta">' + ({paper:'Paper', fiction:'Fiction', code:'Repo', gem:"Gem's", gemsdoc:'GEMs'}[it.type] || 'Post') +
          (it.date ? ' · ' + esc(it.date) : '') + ' ' + tags + '</span></a>';
      }).join('');
    }
    panel.hidden = false;
  }

  input.addEventListener('focus', load);
  input.addEventListener('input', run);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { input.value = ''; run(); input.blur(); }
    if (e.key === 'Enter') {
      var first = panel.querySelector('a');
      if (first) window.location.href = first.getAttribute('href');
    }
  });
  document.addEventListener('click', function (e) {
    if (!document.getElementById('search').contains(e.target)) panel.hidden = true;
  });
})();
</script>

</body>
</html>
