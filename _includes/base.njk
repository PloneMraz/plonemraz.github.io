{%- macro t(s) -%}<span data-l="en">{{ s.en }}</span><span data-l="vi">{{ s.vi }}</span>{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-ui-lang="en" data-sidebar="open">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Plone Mraz</title>
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
<link rel="icon" href="/visual/icon.ico">
<script>
/* Đặt trạng thái TRƯỚC khi vẽ, nếu không sẽ thấy chớp: trang hiện
   tiếng Anh rồi mới đổi sang Việt, hoặc thanh dọc bung ra rồi mới
   thu vào. Phải nằm trong <head>, trước cả stylesheet. */
(function () {
  var r = document.documentElement;
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  var l = get('ui-lang');
  if (l !== 'en' && l !== 'vi') {
    l = (navigator.language || '').toLowerCase().indexOf('vi') === 0 ? 'vi' : 'en';
  }
  r.setAttribute('data-ui-lang', l);
  r.setAttribute('data-sidebar', get('sidebar') === 'closed' ? 'closed' : 'open');
})();
</script>
<link rel="stylesheet" href="/theme.css">
<link rel="stylesheet" href="/assets/vault.css">
</head>
<body class="{% if hideSidebar %}no-sidebar{% endif %}">

{% include "orb.njk" %}

<header class="topbar">
  <a class="brand" href="/">
    <img src="/visual/icon.ico" alt="" width="28" height="28">
    <span>Plone Mraz</span>
  </a>

  <button class="burger" type="button" aria-expanded="false" aria-controls="topnav"
          aria-label="Menu">
    <span></span><span></span><span></span>
  </button>

  <nav class="topnav" id="topnav">
    <a href="/">{{ t(ui.nav.home) }}</a>
    <a href="/vault/"         class="{% if section == 'blog' %}on{% endif %}">{{ t(ui.nav.blog) }}</a>
    <a href="/vault/papers/"  class="{% if section == 'papers' %}on{% endif %}">{{ t(ui.nav.papers) }}</a>
    <a href="/vault/about/"   class="{% if section == 'about' %}on{% endif %}">{{ t(ui.nav.about) }}</a>
    <a href="/vault/contact/" class="{% if section == 'contact' %}on{% endif %}">{{ t(ui.nav.contact) }}</a>
  </nav>
</header>

{% if not hideSidebar %}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-scroll">
  {%- if section == 'papers' %}
    {%- for g in [['programme', ui.label.programme], ['overview', ui.label.overview],
               ['applied', ui.label.applied], ['specs', ui.label.specs]] %}
    <h2 class="side-h">{{ t(g[1]) }}</h2>
    <ul class="side-list">
      {%- for p in papers %}{% if p.group == g[0] %}
      <li>
        <a href="/vault/papers/{{ p.slug }}/"
           class="{% if p.slug == paperSlug %}on{% endif %}">
          {%- if p.code %}<span class="code">{{ p.code }}</span>{% endif %}
          <span class="name">{{ p.title }}</span>
        </a>
      </li>
      {% endif %}{%- endfor %}
    </ul>
    {%- endfor %}
  {%- else %}
    <h2 class="side-h">{{ t(ui.label.posts) }}</h2>
    <ul class="side-list">
      {%- for post in collections.posts %}
      <li>
        <a href="{{ post.url }}" class="{% if post.url == page.url %}on{% endif %}">
          <span class="name">{{ post.data.title }}</span>
          <span class="meta">{{ post.date | readableDate }} · {{ post.data.lang | upper }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  {%- endif %}
  </div>

  <div class="search" id="search">
    <div class="search-panel" id="search-panel" hidden></div>
    <div class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
      <input type="search" id="search-input" autocomplete="off" spellcheck="false"
             placeholder="Search" data-ph-en="Search" data-ph-vi="Tìm kiếm"
             aria-label="Search">
    </div>
  </div>
</aside>

{#  Nút tròn bám cạnh phải của thanh dọc, chạy theo cạnh đó khi
    đóng/mở. Đóng thì nằm sát mép trái trình duyệt.  #}
<button class="side-handle" type="button" id="side-handle"
        aria-controls="sidebar" aria-expanded="true" aria-label="Toggle list">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 5l-7 7 7 7"/>
  </svg>
</button>
{% endif %}

<main class="content">
  {{ content | safe }}
</main>

<button class="langtoggle" type="button" aria-label="Switch interface language">
  <span data-l="en">EN</span><span data-l="vi">VI</span>
</button>

<script>
(function () {
  var root = document.documentElement;
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  /* ---------- Ngôn ngữ giao diện ---------- */
  var input = document.getElementById('search-input');
  function applyLang(l) {
    root.setAttribute('data-ui-lang', l);
    if (input) input.placeholder = input.getAttribute('data-ph-' + l) || 'Search';
  }
  applyLang(root.getAttribute('data-ui-lang') || 'en');

  document.querySelector('.langtoggle').addEventListener('click', function () {
    var next = root.getAttribute('data-ui-lang') === 'en' ? 'vi' : 'en';
    applyLang(next);
    save('ui-lang', next);
  });

  /* ---------- Menu ngang trên màn hẹp ---------- */
  var burger = document.querySelector('.burger'),
      topnav = document.querySelector('.topnav');
  if (burger && topnav) {
    burger.addEventListener('click', function () {
      var open = topnav.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  /* ---------- Thanh dọc ----------
     Mặc định mở ở mọi cỡ màn hình. Chỉ đổi trạng thái qua hai lối:
     bấm nút tròn, hoặc bấm một mục trong danh sách — bấm mục thì
     đóng lại để nhường chỗ cho phần đọc. Trạng thái ghi vào
     localStorage nên nó theo người đọc sang trang kế tiếp. */
  var handle = document.getElementById('side-handle');
  function setSidebar(state) {
    root.setAttribute('data-sidebar', state);
    save('sidebar', state);
    if (handle) handle.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
  }
  if (handle) {
    setSidebar(root.getAttribute('data-sidebar') || 'open');
    handle.addEventListener('click', function () {
      setSidebar(root.getAttribute('data-sidebar') === 'open' ? 'closed' : 'open');
    });
  }
  var list = document.querySelector('.sidebar .sidebar-scroll');
  if (list) {
    list.addEventListener('click', function (e) {
      if (e.target.closest('a')) setSidebar('closed');
    });
  }

  /* ---------- Tìm kiếm ----------
     Khớp theo tên bài và tag. Gõ #tag để lọc riêng theo tag; tag
     lồng nhau nên #triet-hoc bắt luôn #triet-hoc/ban-the.
     Bỏ dấu trước khi so, nên "cay den" tìm ra "Cây Đèn". */
  var panel = document.getElementById('search-panel');
  if (!input || !panel) return;

  function fold(s) {
    return (s || '').normalize('NFD')
      .split('').filter(function (c) {
        var k = c.charCodeAt(0); return k < 0x300 || k > 0x36f;
      }).join('')
      .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();
  }

  var data = null, loading = false;
  function load() {
    if (data || loading) return;
    loading = true;
    fetch('/search.json')
      .then(function (r) { return r.json(); })
      .then(function (j) { data = j; loading = false; run(); })
      .catch(function () { loading = false; });
  }

  function match(q) {
    if (!data) return [];
    if (q.charAt(0) === '#') {
      var tag = fold(q.slice(1));
      if (!tag) return [];
      return data.filter(function (it) {
        return (it.tags || []).some(function (t) {
          var f = fold(t);
          return f === tag || f.indexOf(tag + '/') === 0 || f.indexOf(tag) === 0;
        });
      });
    }
    var n = fold(q);
    return data.filter(function (it) {
      return fold(it.title).indexOf(n) > -1 ||
             fold(it.summary).indexOf(n) > -1 ||
             (it.tags || []).some(function (t) { return fold(t).indexOf(n) > -1; });
    });
  }

  function run() {
    var q = input.value.trim();
    if (!q) { panel.hidden = true; panel.innerHTML = ''; return; }
    if (!data) { load(); return; }

    var hits = match(q).slice(0, 12);
    if (!hits.length) {
      panel.innerHTML = '<p class="search-empty">' +
        '<span data-l="en">No match</span><span data-l="vi">Không có kết quả</span></p>';
    } else {
      panel.innerHTML = hits.map(function (it) {
        var tags = (it.tags || []).map(function (t) {
          return '<span class="t">#' + t + '</span>';
        }).join('');
        return '<a href="' + it.url + '">' +
          '<span class="r-title">' + it.title + '</span>' +
          '<span class="r-meta">' + (it.type === 'paper' ? 'Paper' : 'Post') +
          (it.date ? ' · ' + it.date : '') + ' ' + tags + '</span></a>';
      }).join('');
    }
    panel.hidden = false;
  }

  input.addEventListener('focus', load);
  input.addEventListener('input', run);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { input.value = ''; run(); input.blur(); }
    if (e.key === 'Enter') {
      var first = panel.querySelector('a');
      if (first) window.location.href = first.getAttribute('href');
    }
  });
  document.addEventListener('click', function (e) {
    if (!document.getElementById('search').contains(e.target)) panel.hidden = true;
  });
})();
</script>

</body>
</html>
