{#  Khoang trang giua hai the la CO Y: trinh duyet chi hien mot ban
    nen khong anh huong gi, nhung may doc van ban thuan se thay
    "Home Trang chu" thay vi "HomeTrang chu" dinh lien.  #}
{%- macro t(s) -%}<span data-l="en">{{ s.en }}</span> <span data-l="vi">{{ s.vi }}</span>{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-ui-lang="en" data-sidebar="open">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Plone Mraz</title>
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
<link rel="icon" href="/visual/plonemraz-32.png">
<link rel="apple-touch-icon" href="/visual/plonemraz-180.png">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">

{#  Thẻ chia sẻ. Không có mấy dòng này thì Facebook và các nơi khác
    chỉ hiện một URL trần khi ai đó chia sẻ link.  #}
{%- set ogType = "article" if "/vault/blog/" in page.url else "website" %}
<meta property="og:type" content="{{ ogType }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ summary or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/visual/plonemraz.jpg">
<meta property="og:locale" content="{{ "vi_VN" if lang == "vi" else "en_US" }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ summary or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/visual/plonemraz.jpg">
<script>
/* Đặt trạng thái TRƯỚC khi vẽ, nếu không sẽ thấy chớp: trang hiện
   tiếng Anh rồi mới đổi sang Việt, hoặc thanh dọc bung ra rồi mới
   thu vào. Phải nằm trong <head>, trước cả stylesheet. */
(function () {
  var r = document.documentElement;
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  var l = get('ui-lang');
  if (l !== 'en' && l !== 'vi') {
    l = (navigator.language || '').toLowerCase().indexOf('vi') === 0 ? 'vi' : 'en';
  }
  r.setAttribute('data-ui-lang', l);
  r.lang = l;   // để trình đọc màn hình và trình duyệt biết đúng ngôn ngữ đang hiện
  r.setAttribute('data-sidebar', get('sidebar') === 'closed' ? 'closed' : 'open');
})();
</script>
{#  Umami — đo lượt xem và sự kiện. Không dùng cookie nên không
    cần banner đồng ý.  #}
<script defer src="https://cloud.umami.is/script.js"
        data-website-id="9f201127-5390-459b-800c-6595e8aba080"></script>
<link rel="stylesheet" href="/theme.css">
<link rel="stylesheet" href="/assets/vault.css">
</head>
<body class="{% if hideSidebar %}no-sidebar{% endif %}">

{% include "orb.njk" %}

<header class="topbar">
  <a class="brand" href="/">
    <img src="/visual/plonemraz-64.webp" alt="" width="28" height="28">
    <span>Plone Mraz</span>
  </a>

  <button class="langtoggle" type="button" aria-label="Switch interface language">
    <span data-l="en">EN</span> <span data-l="vi">VIE</span>
  </button>

  <button class="burger" type="button" aria-expanded="false" aria-controls="topnav"
          aria-label="Menu">
    <span></span><span></span><span></span>
  </button>

  <nav class="topnav" id="topnav">
    <a href="/">{{ t(ui.nav.home) }}</a>
    <a href="/vault/"         class="{% if section == 'blog' %}on{% endif %}">Blog</a>
    <a href="/vault/papers/"  class="{% if section == 'papers' %}on{% endif %}">{{ t(ui.nav.papers) }}</a>
    {#  Ba mục dưới dùng một tên chung cho cả hai ngôn ngữ.  #}
    <a href="/vault/ps-gems/"     class="{% if section == 'ai-gen' %}on{% endif %}">P&#39;s Gems</a>
    <a href="/vault/fiction/"     class="{% if section == 'fiction' %}on{% endif %}">Fiction</a>
    <a href="/vault/vibe-coding/" class="{% if section == 'code' %}on{% endif %}">Vibe Coding</a>
    <a href="/vault/books/"   class="{% if section == 'books' %}on{% endif %}">{{ t(ui.nav.books) }}</a>
    <a href="/vault/about/"   class="{% if section == 'about' %}on{% endif %}">{{ t(ui.nav.about) }}</a>
  </nav>
</header>

{% if not hideSidebar %}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-scroll">
  {%- if section == 'papers' %}
    {%- for g in [['programme', ui.label.programme], ['overview', ui.label.overview],
               ['applied', ui.label.applied], ['specs', ui.label.specs]] %}
    <h2 class="side-h">{{ t(g[1]) }}</h2>
    <ul class="side-list">
      {%- for p in papers %}{% if p.group == g[0] %}
      <li>
        <a href="/vault/papers/{{ p.slug }}/"
           class="{% if p.slug == paperSlug %}on{% endif %}">
          {%- if p.code %}<span class="code">{{ p.code }}</span>{% endif %}
          <span class="name">{{ p.title }}</span>
        </a>
      </li>
      {% endif %}{%- endfor %}
    </ul>
    {%- endfor %}

  {%- elif section == 'ai-gen' %}
    <h2 class="side-h">Albums</h2>
    {%- if albums.length %}
    <ul class="side-list">
      {%- for a in albums %}
      <li>
        <a href="/vault/ps-gems/{{ a.slug }}/" class="{% if a.slug == albumSlug %}on{% endif %}">
          <span class="name">{{ a.title }}</span>
          <span class="meta">{{ a.count }} <span data-l="en">images</span> <span data-l="vi">ảnh</span></span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}<p class="side-empty">{{ t(ui.label.empty) }}</p>{%- endif %}

  {%- elif section == 'fiction' %}
    <h2 class="side-h">Fiction</h2>
    {%- if collections.fiction.length %}
    <ul class="side-list">
      {%- for post in collections.fiction %}
      <li>
        <a href="{{ post.url }}" class="{% if post.url == page.url %}on{% endif %}">
          <span class="name">{{ post.data.title }}</span>
          <span class="meta">{{ post.date | readableDate }} · {{ post.data.lang | upper }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}<p class="side-empty">{{ t(ui.label.empty) }}</p>{%- endif %}

  {%- elif section == 'books' %}
    <h2 class="side-h">{{ t(ui.nav.books) }}</h2>
    {%- if books.length %}
    <ul class="side-list">
      {%- for b in books %}
      <li>
        <a href="/vault/books/{{ b.slug }}/" class="{% if b.slug == bookSlug %}on{% endif %}">
          <span class="name">{{ b.title }}</span>
          <span class="meta">{{ b.ext }} · {{ b.size }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}<p class="side-empty">{{ t(ui.label.empty) }}</p>{%- endif %}

  {%- elif section == 'code' %}
    <h2 class="side-h">Repositories</h2>
    {%- if collections.code.length %}
    <ul class="side-list">
      {%- for post in collections.code %}
      <li>
        <a href="{{ post.url }}" class="{% if post.url == page.url %}on{% endif %}">
          <span class="name">{{ post.data.title }}</span>
          {%- if post.data.language %}<span class="meta">{{ post.data.language }}</span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}<p class="side-empty">{{ t(ui.label.empty) }}</p>{%- endif %}

  {%- else %}
    <h2 class="side-h">{{ t(ui.label.posts) }}</h2>
    <ul class="side-list">
      {%- for post in collections.posts %}
      <li>
        <a href="{{ post.url }}" class="{% if post.url == page.url %}on{% endif %}">
          <span class="name">{{ post.data.title }}</span>
          <span class="meta">{{ post.date | readableDate }} · {{ post.data.lang | upper }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  {%- endif %}
  </div>

  <div class="search" id="search">
    <div class="search-panel" id="search-panel" hidden></div>
    <div class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
      <input type="search" id="search-input" autocomplete="off" spellcheck="false"
             placeholder="Search" data-ph-en="Search" data-ph-vi="Tìm kiếm"
             aria-label="Search">
    </div>
  </div>
</aside>

{#  Nút tròn bám cạnh phải của thanh dọc, chạy theo cạnh đó khi
    đóng/mở. Đóng thì nằm sát mép trái trình duyệt.  #}
<button class="side-handle" type="button" id="side-handle"
        aria-controls="sidebar" aria-expanded="true" aria-label="Toggle list">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 5l-7 7 7 7"/>
  </svg>
</button>
{% endif %}

<main class="content">
  {{ content | safe }}
</main>

{%- if section == 'ai-gen' %}
<div class="lbox" id="lbox" role="dialog" aria-modal="true" aria-label="Image viewer">
  <img id="lbox-img" alt="">
  <button class="lbox-close" id="lbox-close" aria-label="Close">&times;</button>
  <button class="lbox-prev"  id="lbox-prev"  aria-label="Previous">&#8249;</button>
  <button class="lbox-next"  id="lbox-next"  aria-label="Next">&#8250;</button>
  <span class="lbox-count" id="lbox-count"></span>
</div>
{%- endif %}

<script>
(function () {
  var root = document.documentElement;
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  /* ---------- Ngôn ngữ giao diện ---------- */
  var input = document.getElementById('search-input');
  function applyLang(l) {
    root.setAttribute('data-ui-lang', l);
    root.lang = l;
    if (input) input.placeholder = input.getAttribute('data-ph-' + l) || 'Search';
  }
  applyLang(root.getAttribute('data-ui-lang') || 'en');

  document.querySelector('.langtoggle').addEventListener('click', function () {
    var next = root.getAttribute('data-ui-lang') === 'en' ? 'vi' : 'en';
    applyLang(next);
    save('ui-lang', next);
  });

  /* ---------- Hai thanh điều hướng ----------
     Quy tắc: mở cái này thì đóng cái kia, và bấm ra ngoài thì đóng
     cả hai. Thanh dọc chỉ tự đóng khi màn HẸP — ở màn rộng nó là
     một cột của bố cục chứ không phải lớp đè, đóng nó mỗi lần bấm
     vào bài đọc sẽ làm cả trang nhảy qua nhảy lại. */
  var narrow = window.matchMedia('(max-width: 68rem)');
  var burger = document.querySelector('.burger');
  var topnav = document.querySelector('.topnav');
  var handle = document.getElementById('side-handle');

  function setTopnav(open) {
    if (!topnav) return;
    topnav.classList.toggle('open', open);
    if (burger) burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  function topnavOpen() { return topnav && topnav.classList.contains('open'); }

  function setSidebar(state) {
    root.setAttribute('data-sidebar', state);
    save('sidebar', state);
    if (handle) handle.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
  }
  function sidebarOpen() { return root.getAttribute('data-sidebar') !== 'closed'; }

  if (burger) {
    burger.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = !topnavOpen();
      setTopnav(open);
      if (open && narrow.matches) setSidebar('closed');
    });
  }

  if (handle) {
    setSidebar(sidebarOpen() ? 'open' : 'closed');
    handle.addEventListener('click', function (e) {
      e.stopPropagation();
      var next = sidebarOpen() ? 'closed' : 'open';
      setSidebar(next);
      if (next === 'open') setTopnav(false);
    });
  }

  // Bấm một mục trong danh sách thì đóng thanh dọc, nhường chỗ đọc
  var list = document.querySelector('.sidebar .sidebar-scroll');
  if (list) {
    list.addEventListener('click', function (e) {
      if (e.target.closest('a')) setSidebar('closed');
    });
  }

  // Bấm ra bất kỳ chỗ nào khác — kể cả chỗ trống — thì đóng
  document.addEventListener('click', function (e) {
    var sidebar = document.getElementById('sidebar');
    if (topnavOpen() && !e.target.closest('.topnav') && !e.target.closest('.burger')) {
      setTopnav(false);
    }
    if (narrow.matches && sidebarOpen() && sidebar &&
        !e.target.closest('#sidebar') && !e.target.closest('.side-handle')) {
      setSidebar('closed');
    }
  });

  // Esc đóng cả hai
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (topnavOpen()) setTopnav(false);
    if (narrow.matches && sidebarOpen()) setSidebar('closed');
  });

  /* ---------- Nút phản hồi ----------
     Hai khối .vote trên mỗi bài (đầu và cuối) dùng chung một khoá,
     nên bấm ở đâu thì cả hai cùng đổi. Lựa chọn lưu trong máy người
     đọc để họ quay lại vẫn thấy mình đã bỏ phiếu, và để không bỏ
     phiếu hai lần.

     GHI CHÚ QUAN TRỌNG: sendVote() hiện KHÔNG gửi đi đâu cả. Site
     là tĩnh, không có máy chủ, nên muốn đếm được thì phải cắm một
     dịch vụ vào đúng hàm này. Chừng nào chưa cắm, lượt bấm chỉ nằm
     trong trình duyệt người đọc. */
  var VOTE_GAP = 800;        // bỏ qua bấm dồn dập dưới ngưỡng này
  var lastVoteAt = 0;

  function sendVote(key, value) {
    /* Ba lớp chặn mềm. Không lớp nào chống được người cố tình — site
       tĩnh không có máy chủ để kiểm — nhưng chúng loại được bấm nhầm,
       bấm dồn, và đổi ý qua lại. Cách phát hiện phá thật sự là so số
       phiếu với số khách duy nhất trong Umami. */
    var now = Date.now();
    if (now - lastVoteAt < VOTE_GAP) return;   // (1) chặn bấm dồn
    lastVoteAt = now;

    var sentKey = 'voted:' + key;              // (2) mỗi phiên chỉ gửi một lần
    try {
      if (sessionStorage.getItem(sentKey)) return;
      sessionStorage.setItem(sentKey, '1');
    } catch (e) {}

    if (window.umami && typeof window.umami.track === 'function') {
      window.umami.track('vote', { post: key, value: value });   // (3) kèm URL bài
    }
  }

  var voteBlocks = [].slice.call(document.querySelectorAll('.vote'));
  if (voteBlocks.length) {
    var voteKey = voteBlocks[0].getAttribute('data-vote-key');
    var storeKey = 'vote:' + voteKey;
    var current = null;
    try { current = localStorage.getItem(storeKey); } catch (e) {}

    function paint() {
      voteBlocks.forEach(function (block) {
        [].slice.call(block.querySelectorAll('.vote-btn')).forEach(function (b) {
          b.setAttribute('aria-pressed',
            b.getAttribute('data-vote') === current ? 'true' : 'false');
        });
      });
    }
    paint();

    voteBlocks.forEach(function (block) {
      block.addEventListener('click', function (e) {
        var btn = e.target.closest('.vote-btn');
        if (!btn) return;
        var picked = btn.getAttribute('data-vote');
        current = (current === picked) ? null : picked;
        try {
          if (current) localStorage.setItem(storeKey, current);
          else localStorage.removeItem(storeKey);
        } catch (err) {}
        paint();
        if (current) sendVote(voteKey, current);
      });
    });
  }

  /* ---------- Tìm kiếm ----------
     Khớp theo tên bài và tag. Gõ #tag để lọc riêng theo tag; tag
     lồng nhau nên #triet-hoc bắt luôn #triet-hoc/ban-the.
     Bỏ dấu trước khi so, nên "cay den" tìm ra "Cây Đèn". */
  var panel = document.getElementById('search-panel');
  if (!input || !panel) return;

  function fold(s) {
    return (s || '').normalize('NFD')
      .split('').filter(function (c) {
        var k = c.charCodeAt(0); return k < 0x300 || k > 0x36f;
      }).join('')
      .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();
  }

  /* Chèn bằng innerHTML nên phải thoát ký tự: tiêu đề có dấu ngoặc
     kép, và về sau tag do người viết đặt cũng có thể chứa ký tự lạ. */
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  /* Cắt tại ranh giới từ để không đứt giữa chữ */
  function clip(s, n) {
    s = String(s == null ? '' : s).trim();
    if (s.length <= n) return s;
    return s.slice(0, n).replace(/\s+\S*$/, '') + '…';
  }

  var data = null, loading = false;
  function load() {
    if (data || loading) return;
    loading = true;
    fetch('/search.json')
      .then(function (r) { return r.json(); })
      .then(function (j) { data = j; loading = false; run(); })
      .catch(function () { loading = false; });
  }

  function match(q) {
    if (!data) return [];
    if (q.charAt(0) === '#') {
      var tag = fold(q.slice(1));
      if (!tag) return [];
      return data.filter(function (it) {
        return (it.tags || []).some(function (t) {
          var f = fold(t);
          return f === tag || f.indexOf(tag + '/') === 0 || f.indexOf(tag) === 0;
        });
      });
    }
    var n = fold(q);
    return data.filter(function (it) {
      return fold(it.title).indexOf(n) > -1 ||
             fold(it.summary).indexOf(n) > -1 ||
             (it.tags || []).some(function (t) { return fold(t).indexOf(n) > -1; });
    });
  }

  function run() {
    var q = input.value.trim();
    if (!q) { panel.hidden = true; panel.innerHTML = ''; return; }
    if (!data) { load(); return; }

    var hits = match(q).slice(0, 12);
    if (!hits.length) {
      panel.innerHTML = '<p class="search-empty">' +
        '<span data-l="en">No match</span> <span data-l="vi">Không có kết quả</span></p>';
    } else {
      panel.innerHTML = hits.map(function (it) {
        var tags = (it.tags || []).map(function (t) {
          return '<span class="t">#' + esc(t) + '</span>';
        }).join('');
        var sum = clip(it.summary, 110);
        return '<a href="' + esc(it.url) + '">' +
          '<span class="r-title">' + esc(it.title) + '</span>' +
          (sum ? '<span class="r-sum">' + esc(sum) + '</span>' : '') +
          '<span class="r-meta">' + ({paper:'Paper', fiction:'Fiction', code:'Repo'}[it.type] || 'Post') +
          (it.date ? ' · ' + esc(it.date) : '') + ' ' + tags + '</span></a>';
      }).join('');
    }
    panel.hidden = false;
  }

  input.addEventListener('focus', load);
  input.addEventListener('input', run);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { input.value = ''; run(); input.blur(); }
    if (e.key === 'Enter') {
      var first = panel.querySelector('a');
      if (first) window.location.href = first.getAttribute('href');
    }
  });
  document.addEventListener('click', function (e) {
    if (!document.getElementById('search').contains(e.target)) panel.hidden = true;
  });
})();
</script>

</body>
</html>
