---
layout: base.njk
---
{#  Chương trong GEMs. Khác bài viết ở một điểm: thứ tự do trường
    `order` quyết định, không do ngày. Front matter dùng: title,
    lede, group (khớp khoá trong _data/gemsGroups.json), order,
    status (ví dụ "đã đóng" / "bảng sơ bộ" / "đang viết").  #}
<article class="prose gems-doc">
  <h1>{{ title }}</h1>

  {%- if status %}
  <p class="kicker"><span class="gems-status">{{ status }}</span></p>
  {%- endif %}

  {%- if lede %}
  <p class="lede">{{ lede }}</p>
  {%- endif %}

  {#  Chương ở đây là BẢN CHỤP của chương trong repo. Repo vẫn chạy
      tiếp, nên phải nói rõ chỗ nào là bản làm việc — cùng lối với
      bản chụp README ở project.njk.  #}
  {%- if source %}
  <p class="paper-actions">
    <a class="btn" href="{{ source }}">
      <span data-l="en">Open on GitHub</span> <span data-l="vi">Mở trên GitHub</span>
    </a>
  </p>
  <p class="note">
    <span data-l="en">Snapshot of the chapter in the GEMs repository. The repository
      itself is the current version.</span>
    <span data-l="vi">Bản chụp chương này trong repo GEMs. Bản đang chạy nằm ở chính
      repo.</span>
  </p>
  {%- endif %}

  {{ content | safe }}

  {%- set prev = collections.gems | getPreviousCollectionItem(page) %}
  {%- set next = collections.gems | getNextCollectionItem(page) %}
  {%- if prev or next %}
  <nav class="doc-nav">
    {%- if prev %}
    <a class="doc-prev" href="{{ prev.url }}">
      <span class="doc-dir"><span data-l="en">Previous</span> <span data-l="vi">Chương trước</span></span>
      <span class="doc-name">{{ prev.data.title }}</span>
    </a>
    {%- endif %}
    {%- if next %}
    <a class="doc-next" href="{{ next.url }}">
      <span class="doc-dir"><span data-l="en">Next</span> <span data-l="vi">Chương sau</span></span>
      <span class="doc-name">{{ next.data.title }}</span>
    </a>
    {%- endif %}
  </nav>
  {%- endif %}
</article>
